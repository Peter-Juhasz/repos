<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		
		<PackageId>PeterJuhasz.Repositories.Abstractions</PackageId>
		<PackageTags>repositories;blobs</PackageTags>
		<PackageProjectUrl>https://github.com/Peter-Juhasz/repos</PackageProjectUrl>
		<VersionPrefix>2.1.0</VersionPrefix>
		<RepositoryUrl>https://github.com/Peter-Juhasz/repos</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="PeterJuhasz.Extensions" Version="2.*-*" />
		<PackageReference Include="PeterJuhasz.Text.Separated" Version="1.*-*" />
	</ItemGroup>

</Project>
