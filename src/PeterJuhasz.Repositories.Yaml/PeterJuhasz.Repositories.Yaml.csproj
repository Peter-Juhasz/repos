<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<PackageId>PeterJuhasz.Repositories.Yaml</PackageId>
		<PackageTags>repositories;blobs;yaml</PackageTags>
		<PackageProjectUrl>https://github.com/Peter-Juhasz/repos</PackageProjectUrl>
		<VersionPrefix>1.0.0</VersionPrefix>
		<RepositoryUrl>https://github.com/Peter-Juhasz/repos</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\PeterJuhasz.Repositories.Abstractions\PeterJuhasz.Repositories.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="PeterJuhasz.Text.Yaml" Version="1.*-*" />
	</ItemGroup>

</Project>
